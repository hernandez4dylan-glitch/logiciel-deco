# Dépendances et compilation (recréées par npm ci / npm run build)
node_modules/
dist/

# Python embarqué et bibliothèques tierces (≈ 160 Mo) : livrés dans le ZIP Windows
runtime/

# Livrables et fichiers temporaires
*.zip
captures-espace-decorateur/
__pycache__/
*.pyc
.claude/hooks/compteur.txt

# Données de boutique : ne jamais les versionner (elles vivent dans %LOCALAPPDATA%)
*.sqlite3
*.sqlite3-journal
.env
.env.*
ia-conv/

# Modèles d'IA (≈ 4 Go) : livrés dans le ZIP Windows, régénérables (local/outils/ia)
local/modeles/*.onnx
local/modeles/*.onnx.data
local/modeles/*.npz
